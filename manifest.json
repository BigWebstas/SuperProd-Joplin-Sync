{
  "id": "joplin-notes-sync",
  "name": "Joplin Notes Sync",
  "manifestVersion": 1,
  "version": "1.1.0",
  "minSupVersion": "18.15.0",
  "description": "Push project notes into a Joplin notebook via Joplin's local Web Clipper API, with optional two-way sync for task notes. Desktop only.",
  "author": "Super Productivity",
  "permissions": [
    "getAllProjects",
    "getAppState",
    "getConfig",
    "updateTask",
    "persistDataSynced",
    "loadSyncedData",
    "setSecret",
    "getSecret",
    "deleteSecret",
    "nodeExecution",
    "showSnack",
    "registerHook",
    "registerHeaderButton",
    "onMessage",
    "onReady",
    "onUnload"
  ],
  "nodeScriptConfig": {
    "timeout": 30000,
    "memoryLimit": "128MB"
  },
  "hooks": ["persistedDataChanged", "anyTaskUpdate"],
  "iFrame": true,
  "isSkipMenuEntry": false,
  "jsonSchemaCfg": "config-schema.json",
  "icon": "icon.svg"
}
